# NextAuth Configuration
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-here-change-this-in-production
NEXTAUTH_URL=http://localhost:3000

# AI Summary Configuration (Optional)
# If not set, users can configure these in the UI

# AI API Endpoint (default: https://api.openai.com/v1/chat/completions)
AI_API_ENDPOINT=https://api.openai.com/v1/chat/completions

# AI API Key (required for AI summary feature)
AI_API_KEY=sk-your-api-key-here

# AI Model (default: gpt-4o-mini)
AI_MODEL=gpt-4o-mini
