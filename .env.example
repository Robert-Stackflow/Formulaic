# NextAuth Configuration
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-here-change-this-in-production
NEXTAUTH_URL=http://localhost:3000

# AI Summary Configuration
# AI API Endpoint (default: https://api.cloudchewie.com/blog/summary)
AI_API_ENDPOINT=https://api.cloudchewie.com/blog/summary

# AI API Key (optional, only if your endpoint requires authentication)
AI_API_KEY=your-ai-api-key-here

# OneSearch: only Search API Key may use NEXT_PUBLIC_ variables
NEXT_PUBLIC_ONESEARCH_SERVER_URL=https://search.cloudchewie.com
NEXT_PUBLIC_ONESEARCH_APP_ID=app_your_application_id
NEXT_PUBLIC_ONESEARCH_SEARCH_KEY=your-search-only-key
# CI/server only; never prefix this Admin API Key with NEXT_PUBLIC_
ONESEARCH_PUBLISH_KEY=your-scoped-admin-key

# GitHub API Configuration (Optional)
# Used as fallback when public GitHub API rate limit is exceeded
# Get a personal access token from https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your-github-token-here
